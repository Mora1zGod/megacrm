{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/bootstrap.ts": {
      "includeFiles": "supabase/**",
      "maxDuration": 300
    },
    "api/sefaz.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/mail",
      "destination": "/api/sefaz"
    },
    {
      "source": "/api/health",
      "destination": "/api/bootstrap-status"
    },
    {
      "source": "/:path((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
