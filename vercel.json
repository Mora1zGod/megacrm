{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/bootstrap.ts": {
      "includeFiles": "supabase/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/:path((?!assets/).*)", "destination": "/index.html" }
  ]
}
